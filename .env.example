# 飞书应用配置（飞书开放平台 -> 你的应用 -> 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter 配置
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_BASE_URL=https://router.tmhcorps.cn/v1

# 使用的模型（OpenRouter 支持的任意模型）
AI_MODEL=anthropic/claude-sonnet-4-5

# 管理员飞书 open_id（逗号分隔），有 /admin 权限，自动收早报和审批通知
ADMIN_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,ou_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# 早报接收人（逗号分隔），仅收早报，无管理权限；可为空
NOTIFY_OPEN_IDS=

# 每个会话保留的历史消息条数
MAX_HISTORY=20

# Web 管理后台 session 签名密钥（固定值防重启后需重新登录）
SESSION_SECRET=换成任意随机长字符串

# 飞书 OAuth 回调地址（需与飞书开放平台配置一致）
ADMIN_REDIRECT_URI=https://pm.tmhcorps.cn/admin/oauth/callback

# ===== 认证跳板 Hub（可选，hub_main.py 独立进程使用）=====
# Hub 对外回调地址（需在飞书开放平台 安全设置-重定向URL 中新增这一条）
HUB_CALLBACK_URI=https://pm.tmhcorps.cn/hub/callback
# state 签名密钥（固定随机长字符串；未配置时复用 SESSION_SECRET）
HUB_SECRET=换成任意随机长字符串
# 接入应用注册表：新增应用加一项后 systemctl --user restart pm-hub
# scopes 按该应用实际需要的权限填写，用户授权页只显示这些
HUB_CLIENTS=[{"id":"chatlogger","secret":"换成随机密钥","redirect_uri":"https://chatlogger.tmhcorps.cn/auth/callback","scopes":"im:message:readonly im:message.group_msg:get_as_user bitable:app im:chat:readonly offline_access docx:document:readonly wiki:wiki:readonly drive:drive:readonly"}]
