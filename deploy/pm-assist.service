[Unit]
Description=PM Assist Feishu Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/pm-assist
ExecStart=%h/pm-assist/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=append:%h/pm-assist/logs/app.log
StandardError=append:%h/pm-assist/logs/app.log

[Install]
WantedBy=default.target
